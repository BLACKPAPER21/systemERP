# SystemERP — contoh environment (boleh di-commit; nilai asli di .env.local)
# JANGAN MENARUH KREDENSIAL ASLI DI BERKAS INI NF-6

# Koneksi PostgreSQL Neon (wajib)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js (wajib) — contoh generate: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-nilai-acak

# Opsional: jumlah maksimum koneksi pool. Default 1 untuk localhost, 10 untuk host lain.
# DB_POOL_MAX=1
